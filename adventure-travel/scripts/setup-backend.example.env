# Copy this file to adventure-travel/.env.setup (git-ignored), fill it in, then run:
#   node scripts/setup-backend.mjs --dry-run   # checks everything, changes nothing
#   node scripts/setup-backend.mjs             # does the setup
# Safe to run again: the SQL files and the Vercel settings are written idempotently.

# ── Required ─────────────────────────────────────────────────────────────────
# Supabase → your avatar → Account → Access Tokens → "Generate new token"
SUPABASE_ACCESS_TOKEN=
# Supabase → your project → Project Settings → General → "Reference ID" (e.g. abcdefghijklmnopqrst)
SUPABASE_PROJECT_REF=
# Vercel → avatar → Account Settings → Tokens → "Create" (scope: your team)
VERCEL_TOKEN=

# ── Admin ────────────────────────────────────────────────────────────────────
# Sign up on the website with this email first; the script makes that account admin.
# (Not signed up yet? Run the script again afterwards — it only adds what's missing.)
ADMIN_EMAIL=

# ── Website address (used for sign-in email links) ───────────────────────────
SITE_URL=https://www.himalayanarcadventure.com

# ── Razorpay (Dashboard → Account & Settings → API Keys; use Test mode first) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Make up a long random text. Paste the SAME text as the "Secret" when you add the
# webhook in Razorpay (URL printed at the end of the script).
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Gmail: Google Account → Security → 2-Step Verification → App passwords) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where new-booking alerts go (defaults to himalayanarcadventure@gmail.com)
BOOKING_TO_EMAIL=

# CRON_SECRET is generated for you if left empty.
CRON_SECRET=
