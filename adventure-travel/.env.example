# Copy to .env.local for local dev (use `vercel dev` — api/ functions don't run under `next dev`).
# For production set the same names in Vercel → Project → Settings → Environment Variables,
# then REDEPLOY (env changes only apply to new deployments).

# ── Supabase (accounts, bookings, activity feed, payments) ──────────────────────
# Run these in the Supabase SQL Editor, in this order: supabase-schema.sql,
# supabase-activity-payments.sql, supabase-backend.sql, supabase-room-sharing.sql,
# supabase-payments-v2.sql.
# Without these two, accounts and online booking/payment are switched off and every form
# offers WhatsApp instead. A production build refuses to start without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used by every api/ function
# (bookings, account, create-order, verify-payment, razorpay-webhook, cron).
SUPABASE_SERVICE_ROLE_KEY=

# ── Emails (api/bookings, payments, api/cron — sent through the notifications outbox) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail: an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_PASS=
# Optional — defaults to himalayanarcadventure@gmail.com
BOOKING_TO_EMAIL=

# ── Razorpay (api/create-order, verify-payment, razorpay-webhook) ───────────────
# Start with TEST keys (rzp_test_…); switch to live keys only after a full test payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ── Scheduled jobs (api/cron) ────────────────────────────────────────────────────
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` on cron calls.
# Use a long random string; anyone with it can trigger reminders and retries.
CRON_SECRET=
